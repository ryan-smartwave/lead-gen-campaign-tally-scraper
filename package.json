{
  "name": "lead-gen-campaign-tally-scraper",
  "version": "0.3.0",
  "description": "Local Express service that tallies campaign hashtags on Instagram and Facebook by driving your own signed-in Chrome, storing results in Postgres. Also usable as a standalone CLI.",
  "type": "module",
  "private": true,
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "node src/index.js",
    "run-once": "node bin/cli.js --run",
    "check": "node bin/cli.js --check",
    "businesses": "node bin/cli.js --list",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:clear": "node scripts/db-clear.mjs",
    "test": "node --test test/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  }
}
