# Copy to .env and fill in. .env is gitignored — never commit real values.

# Postgres connection string. The service stores every result here, so it is
# required for `npm run serve`. The plain CLI (`npm run run-once`) does not need
# it: that path writes files instead.
#
# End it with `?sslmode=verify-full`, not `sslmode=require`. Both behave
# identically under pg 8 — but pg 8 warns on `require` because pg 9 will drop
# the upgrade and fall back to libpq semantics, which skip certificate
# verification. Spelling out verify-full keeps the check across that change.
DATABASE_URL=

# Direct (non-pooled) connection, used only by the migration script.
# Optional — falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Where the service listens. Loopback on purpose: these endpoints drive a real
# signed-in browser, so they must not be reachable from the network.
SCRAPER_HOST=127.0.0.1
SCRAPER_PORT=3900

# Browser origins allowed to call the service (the UI's dev server).
SCRAPER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Campaign day boundary. Every date in the system is derived from this.
CAMPAIGN_TZ=Asia/Manila
